
@startuml

title Trabajo practico programacion 2 - "Fogon del Barrio"

class Cliente {
    - nombre: string
    - apellido: string
    - pedidos: Pedido[]

    + getNombreCompleto(): string
    + asociarPedido(pedido: Pedido): void
    + getPedidos(): Pedido[]
}

Cliente o-- Pedido

class Menu {
    - platos: IPlatoMenu[]

    + agregarPlato(item: IPlatoMenu): void
    + buscarPlatoPorNombre(nombre: string): IPlatoMenu | undefined
    + getPlato(): IPlatoMenu[]
}

interface IPlatoMenu {
    + calcularPrecio(): number
    + obtenerPlatos(): Plato[]
    + getNombre(): string
}

Menu o-- IPlatoMenu

class Plato {
    - nombre: string
    - precio: number
    - categoria: string
    + getCategoria(): string
    + getNombre(): string
    + calcularPrecio(): number
    + obtenerPlatos(): Plato[]
}

IPlatoMenu <|.. Plato

class Combo {
    - nombre: string
    - platosIncluidos: Plato[]
    - beneficio: IEstrategiaBeneficio
    + calcularPrecio(): number
    + obtenerPlatos(): Plato[]
    + getNombre(): string
    + getPlatosIncluidos(): Plato[]
}

IPlatoMenu <|.. Combo
Combo o-- Plato

interface IEstrategiaBeneficio {
    + calcular(precioBase: number): number
}

class DescuentoPorcentual {
    - porcentajeDescuento: number
    + calcular(precioBase: number): number
}

class PrecioFijoCombo {
    - precioFijo: number
    + calcular(precioBase: number): number
}

IEstrategiaBeneficio <|.. DescuentoPorcentual
IEstrategiaBeneficio <|.. PrecioFijoCombo
Combo --> IEstrategiaBeneficio

class Pedido {
    - platosCocina: PlatoPedido[]
    - historialModificacionesPedido: PlatoPedido[][]
    - historialPlatosMenu: IPlatoMenu[][]
    - historialPlatosPorMenu: PlatoPedido[][][]
    - tipoPedido: ITipoPedido
    - estado: IEstadoPedido
    - platosMenu: IPlatoMenu[]
    - platosPorMenu: PlatoPedido[][]

    + agregarPlato(platoMenu: IPlatoMenu): void
    + quitarPlato(platoMenu: IPlatoMenu): void
    + confirmarPedido(registroEstaciones: RegistroEstaciones): void
    + estaListoParaFacturar(): boolean
    + cambiarEstadoPedido(nuevoEstado: IEstadoPedido): void
    + agregarPlatoAlHistorialYCocina(platoMenu: IPlatoMenu): void
    + removerPlatoDelPedido(platoMenu: IPlatoMenu): void
    + verificarPlatosListosParaFacturar(): boolean
    + deshacerUltimaModificacion(): void
    + getPlatosCocina(): PlatoPedido[]
    + getTipoPedido(): ITipoPedido
    + calcularPrecioTotal(): number
    - sumarPlatos(): number
    - removerMenuRegistrado(indiceMenu: number): void
    - removerPlatoInicial(platoMenu: IPlatoMenu): void
    - costoAdicional(): number
    - guardarEstadoEnHistorial(): void
    - agregarPlatosNuevosACocina(platoMenu: IPlatoMenu, notaEspecial: string): void
}

Pedido --> IEstadoPedido

interface IEstadoPedido {
    + agregarPlato(pedido: Pedido, platoMenu: IPlatoMenu): void
    + quitarPlato(pedido: Pedido, platoMenu: IPlatoMenu): void
    + confirmar(pedido: Pedido): void
    + estaListoParaFacturar(pedido: Pedido): boolean
    + validarConfirmacion(): void
    + validarDeshacer(): void
}

class PedidoEnConstruccion {
}

class PedidoConfirmado {
}

IEstadoPedido <|.. PedidoEnConstruccion
IEstadoPedido <|.. PedidoConfirmado

Pedido o-- IPlatoMenu
Pedido *-- PlatoPedido
Pedido --> ITipoPedido

interface ITipoPedido {
    + getDescripcion(): string
    + calcularCostoAdicional(): number
}

class PedidoSalon {
    - costoAdicional: number
    - mesa: number

    + calcularCostoAdicional(): number
    + getDescripcion(): string
    + getMesa(): number
}

class PedidoRetirar {
    - costoAdicional: number
    - horarioRetiro: string

    + calcularCostoAdicional(): number
    + getDescripcion(): string
    + getHorarioRetiro(): string
}

class PedidoEnvio {
    - direccion: string
    - costoEnvio: number

    + getDireccion(): string
    + calcularCostoAdicional(): number
    + getDescripcion(): string
    + calcularEnvio(costoEnvio: number): number
}

ITipoPedido <|.. PedidoSalon
ITipoPedido <|.. PedidoRetirar
ITipoPedido <|.. PedidoEnvio

class PlatoPedido {
    - plato: Plato
    - estado: IEstadoPlatoPedido
    - notaEspecialPlato: string
    + calcularPrecio(): number
    + setEstado(nuevoEstado: IEstadoPlatoPedido): void
    + pasarAPreparacion(): void
    + marcarComoListo(): void
    + estaListo(): boolean
    + puedeModificarse(): boolean
    + getPlato(): Plato
    + getEstado(): IEstadoPlatoPedido
    + getNotaEspecialPedido(): string
}

interface IEstadoPlatoPedido {
    + pasarAPreparacion(platoPedido: PlatoPedido): void
    + marcarListo(platoPedido: PlatoPedido): void
    + estaListo(): boolean
    + puedeModificarse(): boolean
}

class EstadoPendientePlato {
}

class EstadoEnPreparacionPlato {
}

class EstadoListoPlato {
}

PlatoPedido o-- IEstadoPlatoPedido
IEstadoPlatoPedido <|.. EstadoPendientePlato
IEstadoPlatoPedido <|.. EstadoEnPreparacionPlato
IEstadoPlatoPedido <|.. EstadoListoPlato

abstract class EstacionCocina {
    # siguienteEstacion: EstacionCocina | null
    # platosAsignados: PlatoPedido[]
    - platoEnPreparacion: PlatoPedido | null
    # categoriaAtendida: string
    + setSiguiente(estacion: EstacionCocina): EstacionCocina
    + puedeProcesarPlato(platoPedido: PlatoPedido): boolean
    + procesarPlato(platoPedido: PlatoPedido): void
    + iniciarSiguientePlato(): PlatoPedido
    + finalizarPlatoActual(): void
    # puedeManejarPlato(platoPedido: PlatoPedido): boolean
    # agregarPlato(platoPedido: PlatoPedido): void
}

class BarraBebidas {
}

class Parrilla {
}

class CocinaFria {
}

class CocinaDulce {
}

class RegistroEstaciones {
    - primeraEstacion: EstacionCocina | null
    - estacionesRegistradas: EstacionCocina[]
    + registrarEstacion(estacion: EstacionCocina): void
    + validarPlatos(platos: PlatoPedido[]): void
    + derivarPlato(platoPedido: PlatoPedido): void
    + getEstaciones(): EstacionCocina[]
}

EstacionCocina *------- PlatoPedido
EstacionCocina <|-- BarraBebidas
EstacionCocina <|-- Parrilla
EstacionCocina <|-- CocinaFria
EstacionCocina <|-- CocinaDulce
EstacionCocina --> EstacionCocina
RegistroEstaciones o-- EstacionCocina

abstract class MedioDePago {
    - tipoDePago: string
    + pagar(monto: number): number
    + getTipoDePago(): string
}

class Efectivo {
}

class TarjetaDeCredito {
    - recargoPorcentaje: number
    + pagar(monto: number): number
}

class VilleteraVirtual {
}

MedioDePago <|-- Efectivo
MedioDePago <|-- TarjetaDeCredito
MedioDePago <|-- VilleteraVirtual

enum DiaDeLaSemana {
    LUNES
    MARTES
    MIERCOLES
    JUEVES
    VIERNES
    SABADO
    DOMINGO
}

interface IEstrategiaDeDescuento {
    + calcularDescuento(total: number, diaDeSemana: DiaDeLaSemana, medioDePago: MedioDePago): number
}

class DescuentoEfectivo {
    - porcentaje: number
    + calcularDescuento(total: number, diaDeSemana: DiaDeLaSemana, medioDePago: MedioDePago): number
}

class DescuentoDiaEspecial {
    - porcentaje: number
    - diaSemana: DiaDeLaSemana
    + calcularDescuento(total: number, diaDeDescuento: DiaDeLaSemana, medioDePago: MedioDePago): number
}

IEstrategiaDeDescuento <|.. DescuentoEfectivo
IEstrategiaDeDescuento <|.. DescuentoDiaEspecial

class CalculadoraCobro {
    - descuentos: IEstrategiaDeDescuento[]
    + agregarDescuento(estrategia: IEstrategiaDeDescuento): void
    + calcularTotal(pedido: Pedido, medioDePago: MedioDePago, diaActual: DiaDeLaSemana): number
    - aplicarMejorDescuento(totalBase: number, diaActual: DiaDeLaSemana, medioDePago: MedioDePago): number
    - procesarMedioDePago(medioDePago: MedioDePago, monto: number): number
}

CalculadoraCobro --> Pedido
CalculadoraCobro --> MedioDePago
CalculadoraCobro o-- IEstrategiaDeDescuento

class HistorialPedidos {
    - pedidosFinalizados: Pedido[]

    + registrarPedido(pedido: Pedido): void
    + getPedidosFinalizados(): Pedido[]
    + buscarPorTipo(tipoDeDescripcion: string): Pedido[]
}

HistorialPedidos o-- Pedido

@enduml
